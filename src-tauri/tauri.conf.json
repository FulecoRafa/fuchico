{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuchico",
  "version": "0.1.0",
  "identifier": "dev.fuleco.fuchico",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fuchico",
        "width": 1000,
        "height": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Notes editor with Helix modal editing",
    "longDescription": "Fuchico is a standalone desktop notes editor: plain markdown files on disk, edited with real Helix keybindings, with live preview, tasks, tags, backlinks and CalDAV sync.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "editors"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "FulecoRafa",
    "copyright": "\u00a9 2026 FulecoRafa",
    "license": "MIT"
  }
}
